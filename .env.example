DATA_ROOT=/data
SESSIONS_DIR=/data/library/sessions
CHROMA_DIR=/data/appdata/chroma
JOBS_DIR=/data/appdata/jobs
LOCKS_DIR=/data/appdata/locks
EXPORTS_DIR=/data/appdata/exports
BACKUP_ROOT=/data/appdata/backups
ARCHIVE_DIR=/data/library/archive
PREFERENCES_PATH=/data/appdata/preferences.json
FIDELITY_PROFILE_PATH=/data/appdata/speaker_fingerprint.json
FEEDBACK_PATH=/data/appdata/answer_feedback.jsonl
GENERATION_AUDIT_PATH=/data/appdata/generation_audit.jsonl
VOICE_DIR=/data/appdata/voice
SPEAKERS_DIR=/data/appdata/speakers
QWEN_TTS_MLX_MODEL=mlx-community/Qwen3-TTS-12Hz-0.6B-Base-bf16
QWEN_TTS_SENTENCE_BATCH_SIZE=4
QWEN_TTS_WATCHDOG_SECONDS=110
QWEN_TTS_MAX_REQUEST_SECONDS=780
QWEN_TTS_CACHE_LIMIT=96
QWEN_TTS_CACHE_MAX_BYTES=2147483648
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CONTROL_URL=http://host.docker.internal:8778
VOICE_BRIDGE_URL=http://host.docker.internal:8779
LOCAL_BRIDGE_TOKEN=here-i-am-local-v1
VOICE_HOST_DATA_ROOT=/Volumes/Personal/here-i-am
OLLAMA_CHAT_MODEL=gemma4:e4b
OLLAMA_ANALYSIS_MODEL=gemma4:e4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CHAT_MAX_TOKENS=640
OLLAMA_ANALYSIS_MAX_TOKENS=3072
MAX_CHAT_CONTEXT_CHUNKS=6
TEXT_PROVIDER=local
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
OPENAI_API_KEY_HOST_FILE=/absolute/path/to/a/chmod-600-openai-key-file
OPENAI_MODEL=gpt-5.4-mini
ALLOWED_OPENAI_MODELS=gpt-5.4-mini,gpt-5.4
ALLOW_RUNTIME_CLOUD_KEY=false
PROVIDER_STREAM_HEARTBEAT_SECONDS=15
PROVIDER_CONNECT_TIMEOUT_SECONDS=10
PROVIDER_READ_TIMEOUT_SECONDS=300
VOICE_PROVIDER=disabled
VOICE_BATCH_TIMEOUT_SECONDS=900
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
SPEAKER_DIARIZATION_PROVIDER=openai
SPEAKER_DIARIZATION_MODEL=gpt-4o-transcribe-diarize
SPEAKER_DIARIZATION_TIMEOUT_SECONDS=900
AVATAR_IMAGE_MODEL=gpt-image-2
AVATAR_IMAGE_QUALITY=medium
WHISPER_MODEL=small
CHROMA_COLLECTION=here_i_am_chunks
CHROMA_MIGRATION_COLLECTION=here_i_am_chunks_v2
APP_TIMEZONE=America/New_York
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=536870912
MAX_UPLOAD_SECONDS=14400
API_DOCS_ENABLED=false
# The production launcher starts/reconnects Tailscale and adds the current
# MagicDNS hostname to these values in memory before Docker starts. Set this
# to false only for deliberate local-only maintenance.
HERE_I_AM_ENABLE_TAILSCALE=true
# A static hostname can also be recorded here as a fallback, e.g.:
# CORS_ORIGINS=http://localhost:8787,http://127.0.0.1:8787,https://your-mac.your-tailnet.ts.net
# TRUSTED_HOSTS=localhost,127.0.0.1,testserver,host.docker.internal,your-mac.your-tailnet.ts.net
CORS_ORIGINS=http://localhost:8787,http://127.0.0.1:8787
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,host.docker.internal
AUTH_PASSPHRASE_HASH_FILE=
AUTH_PASSPHRASE_HASH_HOST_FILE=/absolute/path/to/a/chmod-600-auth-passphrase-hash-file
AUTH_TOKEN_TTL_SECONDS=2592000
AUTH_MAX_FAILED_ATTEMPTS=10
AUTH_LOCKOUT_SECONDS=900
